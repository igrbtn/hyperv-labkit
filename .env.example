# Copy to .env in the repo root and fill in. NEVER commit real values.
# Convenient editor (local web form, values masked):
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts\creds_editor.ps1

# Hyper-V host reached over WinRM from your workstation.
HYPERV_HOST=
HYPERV_USER=Administrator
HYPERV_PASS=

# Lab admin / domain admin / DSRM password. lib/hv.ps1 substitutes it for the
# literal token __LAB_PW__ in every script it sends, so no password literals
# ever live in files on disk.
LAB_PW=
